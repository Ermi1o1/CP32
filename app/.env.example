# Copy to .env.local (git-ignored) and fill in. Read at build time by Expo.
# See src/config/vep.ts.

# Virtual Event Platform lobby. https only. Leave unset and the
# "Join virtually" buttons say virtual attendance is not configured.
# For the pitch this must be an UNAUTHENTICATED public demo lobby.
EXPO_PUBLIC_VEP_URL=

# Optional: per-session room, with {id} replaced by the session id.
EXPO_PUBLIC_VEP_SESSION_URL=

# Demonstration clock (Stage F). 1 pins "now" to day 2, 10:45 so Home shows
# a live session. Default off: the app uses the real clock.
EXPO_PUBLIC_DEMO_MODE=0
